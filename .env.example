# Copia este archivo a .env.local y completa los valores reales.
# NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY: Supabase →
# Project Settings → API Keys (Project URL + Publishable/anon key).
# Estos dos valores son públicos por diseño (van al navegador) siempre
# que la seguridad real esté en las políticas RLS de cada tabla.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
